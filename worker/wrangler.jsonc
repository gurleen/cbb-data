{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbb-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "DATA",
      // must match R2_BUCKET used by the ETL
      "bucket_name": "cbb-data"
    }
  ],
  // Per-IP rate limiting (Workers Rate Limiting binding). The Worker skips the check
  // when the binding is absent, so removing this block disables it.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
