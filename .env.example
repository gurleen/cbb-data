# Copy to etl/.env (or export in your shell). Never commit real values.

# Cloudflare account ID: used for the R2 endpoint and for Worker deploys
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare R2 (S3-compatible API) - write access, used by the ETL
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cbb-data

# Optional: read-only R2 token stored as a MotherDuck secret for the lake views.
# Falls back to the write keys above (with a warning) if unset.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=

# MotherDuck
MOTHERDUCK_TOKEN=
# MOTHERDUCK_DATABASE=cbb

# Optional: GitHub token for the releases API listing (raises the rate limit)
# GITHUB_TOKEN=

# Optional: where upstream parquet is cached
# CBB_CACHE_DIR=.cache/sportsdataverse

# Worker deploys (GitHub Actions secrets, not needed locally)
# CLOUDFLARE_API_TOKEN=
